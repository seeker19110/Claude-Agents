.venv/
__pycache__/
*.pyc
.env

# Cache công cụ và báo cáo coverage do pytest-cov sinh (nhị phân, đổi mỗi lần chạy) — không thuộc lịch sử git
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# software-company: dữ liệu chạy và cấu hình model cá nhân
software-company/company.sqlite*
software-company/.worktrees/
software-company/llm.yaml
software-company/llm.yaml.bak

# đầu ra mô phỏng examples/donghanhcungban_demo.py
software-company/sim-out/

# Studio-creators: dữ liệu chạy, asset sinh ra và cấu hình cá nhân
Studio-creators/studio.sqlite*
Studio-creators/output/
Studio-creators/llm.yaml
Studio-creators/llm.yaml.bak
Studio-creators/media.yaml

# Studio-creators: OAuth client secret tải từ Google Cloud Console (chỉ dùng cho `studio.youtube login`) — không commit
Studio-creators/client_secret*.json

# gateway: token OAuth nằm ngoài cây repo (~/.x-agents/auth/); trong repo chỉ có venv
gateway/.venv/

# editable install của path dependency (console)
*.egg-info/

# console: token phiên sinh mỗi lần chạy server trực ban (quyền 0600) — không bao giờ commit
console/.console-token

# Claude Code: quyền và cấu hình riêng của từng máy (settings.json dùng chung thì vẫn commit)
.claude/settings.local.json
