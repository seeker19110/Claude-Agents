.venv/
__pycache__/
*.pyc
.env

# Cache công cụ và báo cáo coverage do pytest-cov sinh (nhị phân, đổi mỗi lần chạy) — không thuộc lịch sử git
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# software-company: dữ liệu chạy và cấu hình model cá nhân
software-company/company.sqlite*
software-company/company.artifacts/
software-company/.worktrees/
software-company/llm.yaml
software-company/llm.yaml.bak
software-company/llm.yaml.bak*

# đầu ra mô phỏng examples/donghanhcungban_demo.py — `--out` đặt tên gì cũng được, nên bắt cả các tên hay dùng.
# Thiếu mấy dòng này thì PRD/threat model do model sinh nằm dạng untracked và rất dễ bị `git add` diện rộng
# quét nhầm vào commit (kèm cả repo khách lồng bên trong).
software-company/sim-out/
software-company/real-demo/
software-company/demo-out/

# SQLite tạm do test sinh
*.sqlite
*.sqlite-journal

# Studio-creators: dữ liệu chạy, asset sinh ra và cấu hình cá nhân
Studio-creators/studio.sqlite*
Studio-creators/output/
Studio-creators/llm.yaml
Studio-creators/llm.yaml.bak
Studio-creators/media.yaml
Studio-creators/*.yaml.bak*
*.sqlite*.bak*

# Studio-creators: OAuth client secret tải từ Google Cloud Console (chỉ dùng cho `studio.youtube login`) — không commit
Studio-creators/client_secret*.json

# gateway: token OAuth nằm ngoài cây repo (~/.x-agents/auth/); trong repo chỉ có venv
gateway/.venv/

# editable install của workspace member + đầu ra `uv build`
*.egg-info/
dist/
build/

# console: token phiên sinh mỗi lần chạy server trực ban (quyền 0600) — không bao giờ commit
console/.console-token
# console: log của động cơ do console bật (ADR-0004) — nhật ký chạy, không phải mã nguồn
console/.engine/

# Claude Code: quyền và cấu hình riêng của từng máy (settings.json dùng chung thì vẫn commit)
.claude/settings.local.json

# Claude Code: git worktree tạm của agent chạy nền (harness tạo, tự xoá khi agent xong).
# Commit nhầm nó là commit một bản sao cả repo vào chính repo.
.claude/worktrees/

# log tiến trình orchestrator (sinh lúc chạy)
software-company/var/
Studio-creators/var/
keeper/var/

# keeper: dữ liệu chạy (state quan sát/triage) — không commit
keeper/keeper.sqlite*

# keeper: cấu hình model thật (khoá API / thư mục đăng nhập CLI). Chỉ commit keeper/llm.example.yaml.
keeper/llm.yaml
keeper/llm.yaml.bak
keeper/llm.yaml.bak*
