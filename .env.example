# Chọn hệ sinh thái AI (openai, groq, hoặc gemini)
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# Cấu hình API Key (Điền key tương ứng với LLM_PROVIDER bạn chọn)
OPENAI_API_KEY=sk-xxxxxx
GROQ_API_KEY=gsk_xxxxxx
GOOGLE_API_KEY=AIzaSy_xxxxxx

# Database Configuration (Future use for Giai đoạn 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxxxx
LANGCHAIN_PROJECT=x_agents_project
