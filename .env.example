# ADR-0013. Copy thành .env (đã .gitignore), không commit bản điền thật (AGENTS.md luật cấm 3).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
DELIVER_REMOTE=origin
GH_TOKEN=
# Đường dẫn tuyệt đối tới repo khách trên WSL, ví dụ /mnt/d/khach/qlkh
CLIENT_REPO=
# ADR-0014: trước `up -d` phải có companies/software-company/llm.yaml (compose mount nó, KHÔNG bake vào image)
# và trong đó gateway phải khai base_url: http://host.docker.internal:1123/v1 — trong container `127.0.0.1`
# là chính container, không phải daemon gateway trên host.
