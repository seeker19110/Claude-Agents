{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keeper/topics/patch-proposals",
  "title": "patch-proposals",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "patch-proposals"
    },
    "key": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "description": "Nhánh + diff + phạm vi do `patcher`/`refactorer` chuẩn bị trên worktree riêng của ticket.",
      "properties": {
        "ticket_id": {
          "pattern": "^[A-Za-z0-9_.:/-]{1,200}$",
          "title": "Ticket Id",
          "type": "string"
        },
        "branch": {
          "title": "Branch",
          "type": "string"
        },
        "operation": {
          "enum": [
            "bump_dependency",
            "regen_derived",
            "fix_docs",
            "refactor"
          ],
          "title": "Operation",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "ticket_id",
        "branch",
        "operation",
        "summary"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
