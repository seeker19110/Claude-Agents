{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keeper/topics/debt-ledger",
  "title": "debt-ledger",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "debt-ledger"
    },
    "key": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "description": "Việc bảo trì đã hoãn, mang NGÀY đáo hạn. Không phải `debt_due` của lõi (cái đó đếm chuỗi review liên tiếp, không đo thời gian) — cơ chế riêng của keeper, tên khác có chủ ý.",
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "due_at": {
          "title": "Due At",
          "type": "string"
        },
        "tier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "reason",
        "due_at",
        "tier"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
