{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/requirements-draft",
  "title": "requirements-draft",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "requirements-draft"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "draft",
            "risk"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "FR",
                  "NFR",
                  "constraint"
                ]
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "must",
                  "should",
                  "could",
                  "wont"
                ]
              },
              "quality_char": {
                "type": "string"
              },
              "measure": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "type",
              "text",
              "source",
              "priority"
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "ADR-0037 PR-5e: rủi ro nằm NGAY trong bản draft (lượt `risk` riêng đã bỏ). Bắt buộc — mảng rỗng nghĩa là \"đã rà và không thấy rủi ro\", còn thiếu trường thì không phân biệt được với \"chưa rà\"."
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "kind",
        "risks"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
