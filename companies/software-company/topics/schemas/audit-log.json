{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/audit-log",
  "title": "audit-log",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "audit-log"
    },
    "key": {
      "type": "string",
      "description": "= actor"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number",
          "description": "chi phí USD tính từ bảng giá trong llm.yaml (0 nếu model không có giá)"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "token đầu ra (ngân sách ticket đo theo đây, không đo tổng)"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "description": "ADR-0037: pha của lượt (`AgentSpec.phases`); null khi agent không chia pha"
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
