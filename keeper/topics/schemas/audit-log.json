{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keeper/topics/audit-log",
  "title": "audit-log",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "audit-log"
    },
    "key": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "description": "",
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "tokens": {
          "default": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "ticket_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticket Id"
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
