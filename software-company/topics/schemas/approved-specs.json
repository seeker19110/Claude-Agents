{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/approved-specs",
  "title": "approved-specs",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "approved-specs"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending_human",
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "prd": {
              "type": "string"
            },
            "requirements": {
              "type": "string"
            },
            "glossary": {
              "type": "string"
            },
            "adr": {
              "type": "string"
            },
            "risks": {
              "type": "string"
            }
          },
          "required": [
            "prd",
            "requirements"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "application",
            "library"
          ],
          "description": "loại sản phẩm (ADR-0029): `application` = có điểm vào chạy được, BẮT BUỘC khai `runtime` — thiếu thì QA hồi quy bị hạ fail; `library` = không có server, smoke không áp dụng"
        },
        "runtime": {
          "type": "object",
          "description": "cách khởi động sản phẩm để orchestrator smoke (ADR-0029); thiếu thì `release-events.smoke.unverified`",
          "properties": {
            "command": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "lệnh khởi động; có thể chứa {port}"
            },
            "port": {
              "type": "integer",
              "description": "0 = orchestrator chọn cổng trống"
            },
            "health": {
              "type": "string",
              "description": "đường GET để kiểm, mặc định /"
            },
            "timeout_s": {
              "type": "integer"
            },
            "expect_status": {
              "type": "integer"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": true
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "status",
        "artifacts"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
