{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/incidents",
  "title": "incidents",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "incidents"
    },
    "key": {
      "type": "string",
      "description": "= incident_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "SEV1",
            "SEV2",
            "SEV3",
            "SEV4"
          ]
        },
        "summary": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string"
        },
        "root_cause_class": {
          "enum": [
            "requirement",
            "design",
            "code",
            "ops",
            "external"
          ],
          "description": "requirement → research-requests; design → threat-model/architecture; code/ops → tasks"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "dự án liên quan (nếu biết)"
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "incident_id",
        "severity",
        "summary",
        "root_cause_class"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
