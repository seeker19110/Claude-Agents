{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/incidents",
  "title": "incidents",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "incidents"
    },
    "key": {
      "type": "string",
      "description": "= incident_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "SEV1",
            "SEV2",
            "SEV3",
            "SEV4"
          ]
        },
        "summary": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string"
        },
        "root_cause_class": {
          "enum": [
            "requirement",
            "design",
            "code",
            "ops",
            "external"
          ],
          "description": "requirement → research-requests; design → threat-model/architecture; code/ops → tasks"
        }
      },
      "required": [
        "incident_id",
        "severity",
        "summary"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
