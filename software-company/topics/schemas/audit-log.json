{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/audit-log",
  "title": "audit-log",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "audit-log"
    },
    "key": {
      "type": "string",
      "description": "= actor"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number",
          "description": "chi phí USD tính từ bảng giá trong llm.yaml (0 nếu model không có giá)"
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
