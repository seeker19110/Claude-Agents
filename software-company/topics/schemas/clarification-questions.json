{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/clarification-questions",
  "title": "clarification-questions",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "clarification-questions"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "round": {
          "type": "integer",
          "maximum": 2
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "req_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text",
              "options",
              "default"
            ]
          }
        }
      },
      "required": [
        "project_id",
        "round",
        "questions"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}