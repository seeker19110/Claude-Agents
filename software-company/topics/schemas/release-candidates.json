{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/release-candidates",
  "title": "release-candidates",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "release-candidates"
    },
    "key": {
      "type": "string",
      "description": "= release_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "project_id",
        "tickets",
        "version"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}