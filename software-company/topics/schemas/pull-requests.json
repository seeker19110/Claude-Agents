{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/pull-requests",
  "title": "pull-requests",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "pull-requests"
    },
    "key": {
      "type": "string",
      "description": "= ticket_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "pr_ref": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "impact": {
          "type": "object"
        },
        "local_checks": {
          "type": "object",
          "properties": {
            "lint": {
              "type": "boolean"
            },
            "tests": {
              "type": "boolean"
            },
            "coverage": {
              "type": "number"
            },
            "verified_by": {
              "enum": [
                "workspace",
                null
              ],
              "description": "chỉ code đặt \"workspace\" sau khi thật sự chạy lint/test; agent không chạy được thì để null (= chưa xác minh)"
            },
            "unverified": {
              "type": "boolean"
            },
            "stack": {
              "type": "string"
            }
          }
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "dự án của ticket; orchestrator điền từ kế hoạch nếu model bỏ trống"
        },
        "tests_authored_by": {
          "enum": [
            "test-author",
            "assignee"
          ],
          "description": "ADR-0028: ai viết bộ test của ticket. `assignee` = KHÔNG độc lập (không phân vùng được vùng test, hoặc chạy không bật test-author) — reviewer phải tự chấm test kỹ hơn."
        },
        "test_dispute": {
          "type": [
            "string",
            "null"
          ],
          "description": "ADR-0028: assignee cho rằng bộ test sai đặc tả (nó không sửa được test). Nội dung = lý do; route đưa việc về test-author."
        },
        "test_suite": {
          "type": "object",
          "description": "bộ test do test-author viết: files[], acceptance_covered[], tests_status, commit",
          "additionalProperties": true
        }
      },
      "required": [
        "ticket_id",
        "branch",
        "pr_ref",
        "local_checks"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
