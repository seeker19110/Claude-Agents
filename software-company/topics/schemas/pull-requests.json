{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/pull-requests",
  "title": "pull-requests",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "pull-requests"
    },
    "key": {
      "type": "string",
      "description": "= ticket_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "pr_ref": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "impact": {
          "type": "object"
        },
        "local_checks": {
          "type": "object",
          "properties": {
            "lint": {
              "type": "boolean"
            },
            "tests": {
              "type": "boolean"
            },
            "coverage": {
              "type": "number"
            },
            "verified_by": {
              "enum": [
                "workspace"
              ]
            },
            "unverified": {
              "type": "boolean"
            },
            "stack": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "ticket_id",
        "branch",
        "pr_ref",
        "local_checks"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
