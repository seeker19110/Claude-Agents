{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/shared-context",
  "title": "shared-context",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "shared-context"
    },
    "key": {
      "type": "string",
      "description": "= namespace"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "namespace": {
          "enum": [
            "prd",
            "glossary",
            "design",
            "architecture",
            "api-contract",
            "schema",
            "threat-model",
            "infra",
            "analytics",
            "docs",
            "knowledge",
            "contract"
          ]
        },
        "version": {
          "type": "integer"
        },
        "content_ref": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = toàn công ty (knowledge)"
        },
        "content": {
          "type": [
            "string",
            "null"
          ],
          "description": "toàn văn artifact (markdown/yaml); bus là nguồn sự thật, artifact store chỉ là bản mirror ra file"
        }
      },
      "required": [
        "namespace",
        "version",
        "content_ref"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
