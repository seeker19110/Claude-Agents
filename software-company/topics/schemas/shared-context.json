{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/shared-context",
  "title": "shared-context",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "shared-context"
    },
    "key": {
      "type": "string",
      "description": "= namespace"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "namespace": {
          "enum": [
            "prd",
            "glossary",
            "design",
            "architecture",
            "api-contract",
            "schema",
            "threat-model",
            "infra",
            "analytics",
            "docs",
            "knowledge"
          ]
        },
        "version": {
          "type": "integer"
        },
        "content_ref": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "toàn văn artifact (markdown/yaml); bus là nguồn sự thật, artifact store chỉ là bản mirror ra file"
        }
      },
      "required": [
        "namespace",
        "version",
        "content_ref"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
