{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/clarification-answers",
  "title": "clarification-answers",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "clarification-answers"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question_id",
              "answer"
            ]
          }
        }
      },
      "required": [
        "project_id",
        "answers"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}