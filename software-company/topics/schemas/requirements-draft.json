{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/requirements-draft",
  "title": "requirements-draft",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "requirements-draft"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "draft",
            "risk"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "FR",
                  "NFR",
                  "constraint"
                ]
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "must",
                  "should",
                  "could",
                  "wont"
                ]
              },
              "quality_char": {
                "type": "string"
              },
              "measure": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "type",
              "text",
              "source",
              "priority"
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "project_id",
        "kind"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}