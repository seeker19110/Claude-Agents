{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/acceptance-results",
  "title": "acceptance-results",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "acceptance-results"
    },
    "key": {
      "type": "string",
      "description": "= release_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "accepted",
            "rejected",
            "conditional"
          ]
        },
        "signed_by": {
          "type": "string",
          "description": "người của khách ký nghiệm thu"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "block",
                  "warn",
                  "nit"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "text"
            ]
          }
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "release_id",
        "project_id",
        "verdict",
        "signed_by"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
