{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/research-requests",
  "title": "research-requests",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "research-requests"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "project_id",
        "description"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}