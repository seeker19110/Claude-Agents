{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/research-requests",
  "title": "research-requests",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "research-requests"
    },
    "key": {
      "type": "string",
      "description": "= project_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repo": {
          "type": "string",
          "description": "ADR-0025: đường dẫn repo git của khách cho RIÊNG dự án này (tuyệt đối, hoặc tương đối với cwd của orchestrator). Bỏ trống = dùng --repo của tiến trình."
        },
        "base": {
          "type": "string",
          "description": "nhánh/commit nền để rẽ nhánh tích hợp của dự án (mặc định = --base của tiến trình)"
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "description"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
