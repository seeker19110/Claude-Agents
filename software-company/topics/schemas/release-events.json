{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/release-events",
  "title": "release-events",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "release-events"
    },
    "key": {
      "type": "string",
      "description": "= release_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "env": {
          "enum": [
            "staging",
            "canary",
            "production"
          ]
        },
        "status": {
          "enum": [
            "pending_human",
            "deployed",
            "rolled_back",
            "failed"
          ]
        },
        "rollback_plan": {
          "type": "string"
        },
        "runbook_ref": {
          "type": "string"
        },
        "integration_branch": {
          "type": "string"
        },
        "integration_sha": {
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "version",
        "env",
        "status"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
