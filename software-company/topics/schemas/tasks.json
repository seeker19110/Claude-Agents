{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/tasks",
  "title": "tasks",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "tasks"
    },
    "key": {
      "type": "string",
      "description": "= ticket_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "requirement_id": {
          "type": "string"
        },
        "assignee": {
          "enum": [
            "backend",
            "frontend",
            "mobile",
            "database",
            "platform",
            "data"
          ]
        },
        "risk_tags": {
          "type": "array",
          "description": "auth|payment|pii|crypto|upload|admin|external-api — có tag thì bắt buộc review security",
          "items": {
            "type": "string"
          }
        },
        "estimate_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimate_days": {
          "type": "number"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "hint": {
          "type": "string"
        },
        "budget_tokens": {
          "type": "integer"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 cao nhất; delivery-lead dispatch theo priority"
        },
        "budget_usd": {
          "type": "number",
          "description": "trần chi phí USD của ticket; supervisor cắt khi chạm (tuỳ chọn, ngoài budget_tokens)"
        }
      },
      "required": [
        "ticket_id",
        "project_id",
        "requirement_id",
        "assignee",
        "title",
        "acceptance",
        "retry"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
