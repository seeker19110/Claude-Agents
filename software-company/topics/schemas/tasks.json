{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/tasks",
  "title": "tasks",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "tasks"
    },
    "key": {
      "type": "string",
      "description": "= ticket_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "requirement_id": {
          "type": "string"
        },
        "assignee": {
          "enum": [
            "builder"
          ],
          "description": "ADR-0037 PR-5d: một agent viết code cho mọi mảng; mảng kỹ thuật nằm ở `stack`"
        },
        "stack": {
          "description": "ADR-0037: mảng kỹ thuật của ticket = PHA của `builder` (skill của mảng nạp theo trường này); thiếu thì builder chạy bằng prompt chung",
          "enum": [
            "backend",
            "frontend",
            "mobile",
            "database",
            "platform",
            "data",
            null
          ]
        },
        "risk_tags": {
          "type": "array",
          "description": "auth|payment|pii|crypto|upload|admin|external-api — có tag thì bắt buộc review security",
          "items": {
            "type": "string"
          }
        },
        "estimate_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimate_days": {
          "type": "number"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "hướng dẫn của NGƯỜI (gate escalation/comment) — delivery-lead KHÔNG ghi đè khi retry, khác `hint`"
        },
        "budget_tokens": {
          "type": "integer"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 cao nhất; delivery-lead dispatch theo priority"
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "trần chi phí USD của ticket; supervisor cắt khi chạm (tuỳ chọn, ngoài budget_tokens)"
        },
        "rulings": {
          "type": "array",
          "description": "ADR-0030 sổ Ruling: quyết định bạn TỰ đưa ra thay vì dừng chờ người. Chỉ dừng chờ người ở bốn việc: không đảo ngược được; nhạy cảm bảo mật; tác động ra ngoài worktree (merge/push/publish); kế hoạch hỏng tới mức mọi hướng đều là đoán. Mọi chỗ bí khác: tự quyết theo spec/shared-context, ghi một mục ở đây rồi đi tiếp. Rỗng khi không có gì phải quyết.",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "description": "quyết gì"
              },
              "why": {
                "type": "string",
                "description": "căn cứ: spec, shared-context, quy ước, hay giả định"
              },
              "cost_if_wrong": {
                "type": "string",
                "description": "sai thì mất gì — rework bao nhiêu, ai chịu"
              }
            },
            "required": [
              "decision",
              "why",
              "cost_if_wrong"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ticket_id",
        "project_id",
        "requirement_id",
        "assignee",
        "title",
        "acceptance"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
