{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-company/topics/supervisor-actions",
  "title": "supervisor-actions",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "supervisor-actions"
    },
    "key": {
      "type": "string",
      "description": "= target"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "escalate",
            "budget_cut",
            "warn"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "target",
        "action",
        "reason"
      ],
      "additionalProperties": true
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
